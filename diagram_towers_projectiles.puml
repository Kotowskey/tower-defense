@startuml
title Tower Defense - Wieże i Pociski (System Ataku)

' Ustawienia graficzne, aby diagram był czytelny
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam backgroundColor white

package "Towers (Wieże)" {
    abstract class BaseTower {
        + tower_name: String
        + tower_level: int
        + tower_range: float
        + tower_damage: int
        + tower_fire_rate: float
        + tower_cost: int
        + is_placed: bool
        + target: Node
        + projectile_scene: PackedScene
        __
        + find_new_target()
        + fire_at_target(target)
        + spawn_projectile(target)
        + upgrade(): int
        + apply_upgrade_effects()
        + apply_permanent_upgrades()
        + show_range(bool)
        + get_tower_stats(): Dictionary
        + get_tower_type(): String
        + get_tower_description(): String
    }

    class BasicTower {
        __
        + get_tower_type(): String
        + apply_upgrade_effects()
    }
    
    class SniperTower {
        __
        + get_tower_type(): String
        + apply_upgrade_effects()
    }
    
    class MachineGunTower {
        __
        + get_tower_type(): String
        + apply_upgrade_effects()
        + get_tower_description(): String
    }
    
    class MagicTower {
        __
        + get_tower_type(): String
        + apply_upgrade_effects()
        + get_tower_description(): String
    }

    class IceTower {
        + slow_factor: float
        + slow_duration: float
        __
        + get_tower_type(): String
        + apply_upgrade_effects()
    }

    class RocketTower {
        __
        + get_tower_type(): String
        + fire_rocket(target)
        + apply_upgrade_effects()
    }

    BaseTower <|-- BasicTower
    BaseTower <|-- SniperTower
    BaseTower <|-- MachineGunTower
    BaseTower <|-- MagicTower
    BaseTower <|-- IceTower
    BaseTower <|-- RocketTower
}

package "Projectiles (Pociski)" {
    abstract class BaseProjectile {
        + speed: float
        + damage: int
        + target: Node
        + has_area_damage: bool
        __
        + setup(pos, target, damage)
        + on_hit()
        + deal_area_damage()
        + create_explosion_effect()
    }

    class BasicProjectile {
        __
        + setup(pos, target, damage)
    }
    
    class SniperProjectile {
        __
        + setup(pos, target, damage)
    }
    
    class RocketProjectile {
        __
        + on_hit()
        + deal_area_damage()
    }
    
    class IceProjectile {
        + slow_factor: float
        + slow_duration: float
        __
        + set_slow_properties()
        + on_hit()
    }

    BaseProjectile <|-- BasicProjectile
    BaseProjectile <|-- SniperProjectile
    BaseProjectile <|-- RocketProjectile
    BaseProjectile <|-- IceProjectile
}

' ========================================
' Relacje między wieżami a pociskami
' ========================================

' Każda wieża tworzy swój odpowiedni pocisk
BasicTower ..> BasicProjectile : tworzy
SniperTower ..> SniperProjectile : tworzy
MachineGunTower ..> BasicProjectile : tworzy
IceTower ..> IceProjectile : tworzy
RocketTower ..> RocketProjectile : tworzy
MagicTower ..> RocketProjectile : tworzy

note right of BaseTower
  Wieże znajdują się w:
  scripts/towers/
end note

note right of BaseProjectile
  Pociski znajdują się w:
  scripts/projectiles/
end note

@enduml
